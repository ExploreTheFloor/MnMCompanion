<UserControl x:Class="MnMCompanion.LootHistoryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource Window}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <UserControl.Resources>
        <DataTemplate x:Key="DayItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Coin}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock Text="coin + items" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MemberItem">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Sub}" FontSize="11" Foreground="{StaticResource Muted}" Margin="16,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="3" Margin="16,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fill}"/>
                        <ColumnDefinition Width="{Binding Rest}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="1.5" Background="{StaticResource Subtle}"/>
                    <Border CornerRadius="1.5" Background="{Binding Brush}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Days -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,8,8">
                <DockPanel DockPanel.Dock="Top" Margin="6,0,4,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Open the ledger folder" Click="OnOpenFolder"/>
                    <StackPanel>
                        <TextBlock Text="Loot" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DayCount" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" TextChanged="OnSearch"/>
                    <TextBlock Text="Filter by player, item or mob" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" x:Name="SearchHint"/>
                </Grid>
                <ListBox x:Name="DayList" Style="{StaticResource NavList}" ItemTemplate="{StaticResource DayItem}"
                         SelectionChanged="OnDaySelected" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                               Margin="10,12,0,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Group members -->
        <Border Grid.Column="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,16,8,8">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,4,12">
                    <TextBlock x:Name="DayTitle" Text="No day selected" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DayWhen" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    <Border x:Name="ScopeHost" CornerRadius="8" Background="{StaticResource Subtle}" Padding="2" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="ScopeBar"/>
                    </Border>
                </StackPanel>
                <ListBox x:Name="MemberList" Style="{StaticResource NavList}" ItemTemplate="{StaticResource MemberItem}"
                         SelectionChanged="OnMemberSelected"/>
            </DockPanel>
        </Border>

        <!-- Breakdown -->
        <ScrollViewer Grid.Column="2" x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,28" x:Name="Detail">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="HeadSwatch" Width="12" Height="12" CornerRadius="3" Margin="0,2,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HeadName" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </StackPanel>
                        <TextBlock x:Name="HeadSub" FontSize="12" Foreground="{StaticResource Muted}" Margin="22,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeadBig" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        <TextBlock x:Name="HeadBigCaption" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                    </StackPanel>
                </Grid>

                <WrapPanel x:Name="Tiles" Margin="0,0,-10,6"/>

                <DockPanel Margin="0,0,0,10">
                    <StackPanel x:Name="CopyBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Border CornerRadius="8" Background="{StaticResource Subtle}" Padding="2" HorizontalAlignment="Left">
                        <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
                    </Border>
                </DockPanel>

                <ContentControl x:Name="TabContent"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
