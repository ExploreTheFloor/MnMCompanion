<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads the game's ledger files and turns them into loot. Nothing here touches the game, a database or the network. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LootWindow</RootNamespace>
  </PropertyGroup>

</Project>
