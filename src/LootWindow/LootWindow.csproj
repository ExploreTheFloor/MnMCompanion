<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loot Goblin: who looted what, read from the game's own ledger files. Reads files only; it never touches the game. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LootWindow</RootNamespace>
    <AssemblyName>LootGoblin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Loot Goblin for Monsters &amp; Memories</Product>
    <Description>Shows who looted what in Monsters &amp; Memories, from the game's own ledger files.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LootWindow.Core\LootWindow.Core.csproj" />
    <ProjectReference Include="..\LootWindow.Data\LootWindow.Data.csproj" />
    <ProjectReference Include="..\LootWindow.Update\LootWindow.Update.csproj" />
  </ItemGroup>

</Project>
