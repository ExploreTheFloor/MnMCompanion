<Project Sdk="Microsoft.NET.Sdk">

  <!-- This app's own database: every ledger row it has ever read, kept for later. The one place a package is allowed (see LedgerOnlyTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LootWindow.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LootWindow.Core\LootWindow.Core.csproj" />
  </ItemGroup>

</Project>
